# Moodle (Web Service API - servicio moodle_mobile_app)
MOODLE_BASE_URL=https://aulasvirtuales.bue.edu.ar
MOODLE_TOKEN=
# IDs de curso a monitorear, separados por coma (ver npm run list-courses)
MOODLE_COURSE_IDS=29883,29860,29689,29678,29568,28312

# Canales de notificación: "telegram", "ntfy", o "telegram,ntfy" para ambos (default: telegram)
NOTIFY_CHANNELS=telegram

# Telegram (requerido si NOTIFY_CHANNELS incluye "telegram")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy.sh (requerido si NOTIFY_CHANNELS incluye "ntfy") — no requiere cuenta ni token,
# elegí un nombre de topic único (no adivinable) y suscribite desde la app o la web:
# https://ntfy.sh/docs/subscribe/phone/
NTFY_TOPIC_URL=https://ntfy.sh/tu-topic-unico-aca

# Opcionales
# Ventana en días para avisar "vence pronto" (default 7)
DUE_SOON_DAYS=7
# Pausa en ms entre llamadas por-curso/por-foro a la API de Moodle (default 400)
MOODLE_RATE_LIMIT_MS=400
# Patrón (regex, case-insensitive) de nombres de foro a NO rastrear (default: oficinas/grupos ajenos)
FORUM_IGNORE_PATTERN=oficina|grupo\s*\d+
